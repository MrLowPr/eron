# ─── Database ────────────────────────────────────────────────────────────────
# Local: postgres via docker compose. Remote: Neon / Supabase / Railway connection string.
DATABASE_URL="postgresql://eron:eronpass@localhost:5433/eron?schema=public"

# ─── Auth.js (NextAuth v5) ──────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

AUTH_TRUST_HOST="true"

# Google OAuth (optional). Get credentials at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the app, used for email links & SEO.
APP_URL="http://localhost:3000"

# ─── Email verification / password reset ────────────────────────────────────
# Uses Resend HTTP API when RESEND_API_KEY is set, otherwise links are logged to the server console.
RESEND_API_KEY=""
RESEND_FROM="Eron <onboarding@resend.dev>"

# ─── Uploads (local storage) ────────────────────────────────────────────────
UPLOAD_MAX_SIZE="6291456" # 6 MB in bytes
UPLOAD_MAX_IMAGES="5"

# ─── Redis (optional — for distributed rate limiting via Upstash REST) ──────
# If unset, an in-memory limiter is used (fine for development / single instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
